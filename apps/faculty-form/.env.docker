# Docker local development environment
# Loaded by Vite when running with --mode docker
# API calls go through nginx (port 8080) which routes to the PHP backend

VITE_BASE_API_URL=http://localhost:8080
VITE_APP_ENV=development
VITE_BASE_PATH=/form/

# Override API paths to use nginx-proxied local backend
VITE_COURSE_RESERVES_PATH=/course-reserves/backend/web
VITE_AUTH_PATH=/course-reserves/backend/admin
VITE_FOLIO_PATH=/folio/web

# FOLIO application (still hits production — read-only)
VITE_FOLIO_BASE_URL=https://fivecolleges.folio.ebsco.com
