# Copy this file to .env and fill in real values.
# NEVER commit .env (it is listed in .gitignore).

# dev | test | prod; defaults to prod when unset or unrecognized.
YII_ENV=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db
DB_NAME=reserves
DB_USER=
DB_PASS=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | tr -d '=+/' | head -c 64
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ── EBSCO EDS API ─────────────────────────────────────────────────────────────
EBSCO_USER_ID=
EBSCO_PASSWORD=
# EDS profile identifier supplied by EBSCO.
EBSCO_PROFILE=
EBSCO_IP_PREFIXES=

# ── Hitchcock document-delivery service ──────────────────────────────────────
HITCHCOCK_USERNAME=
HITCHCOCK_PASSWORD=

# ── FOLIO search service ─────────────────────────────────────────────────────
FOLIO_SEARCH_BASE_URL=
FOLIO_TIMEOUT_SECONDS=
LINK_SUGGESTION_STALE_MINUTES=10
LINK_SUGGESTION_REFRESH_LIMIT=10
LINK_SUGGESTION_PAGE_SIZE=20
# Fake local mode is set together with nginx by: docker/start.sh --fake-folio
# FOLIO_SEARCH_BASE_URL=http://fake-folio:3000/folio/web/search

# ── Dev user (authorize-local.php only) ──────────────────────────────────────
DEV_USERNAME=devadmin

# Cookie signing key (generate independently of JWT keys)
COOKIE_VALIDATION_KEY=

# Private SpringShare export URL; needed only for the import command
SPRINGSHARE_EXPORT_URL=

# Optional site-specific origins, provider settings and administrator recipients.
# Lists are comma-separated. Empty values add no origins/prefixes/recipients.
CORS_ALLOWED_ORIGINS=
FACULTY_FORM_URL=
ADMIN_EMAILS=

# ── Syllabus storage ─────────────────────────────────────────────────────────
# Defaults to a private directory under @runtime, outside web/.
SYLLABUS_STORAGE_PATH=
# Maximum decoded PDF/DOCX upload size; default is 10485760 bytes (10 MiB).
SYLLABUS_MAX_UPLOAD_BYTES=
# Google export base; requests are restricted to docs.google.com and Googleusercontent redirects.
GOOGLE_DOC_BASE_URL=
